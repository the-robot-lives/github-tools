#!/usr/bin/env bash
# agh — run `gh` authenticated as a GitHub App installation instead of the user.
#
# Usage:  agh [gh args...]            e.g. agh pr view 42 -R owner/repo
#         agh --print-token           print the short-lived installation token (explicit opt-in)
#         agh --help
#
# Credentials (env / direnv — never committed). Defaults shown are for the
# noizu-agentic-coder app (app 5220485, the-robot-lives org installation).
#   AGH_APP_ID           GitHub App numeric id (default 5220485)
#   AGH_INSTALLATION_ID  installation id. Unset or "auto" (the default)
#                        resolves the installation whose account matches the
#                        target repo's owner — from -R/--repo, GH_REPO, or the
#                        cwd's origin remote — via GET /app/installations.
#                        With no repo context, succeeds only when the app has
#                        exactly one installation. A number pins that
#                        installation explicitly.
#   AGH_PRIVATE_KEY_PATH app's PEM private key (default
#                        ~/Work/Space/Noizu/secrets/noizu-agentic-coder.private-key.pem)
#
# Dependencies: openssl, curl, jq. Exits with gh's status otherwise;
# non-gh failures exit 3 (matches gh-wait's usage/tool-error code).

set -euo pipefail

API="https://api.github.com"
VERSION="0.3.0"

# Defaults for the noizu-agentic-coder GitHub App (override via env).
: "${AGH_APP_ID:=5220485}"
: "${AGH_PRIVATE_KEY_PATH:=$HOME/Work/Space/Noizu/secrets/noizu-agentic-coder.private-key.pem}"

die() { echo "agh: $*" >&2; exit 3; }

[[ ${1:-} == "--help" || ${1:-} == "-h" ]] && sed -n '2,/^set -euo pipefail$/p' "$0" | sed '$d' && exit 0
[[ ${1:-} == "--version" ]] && echo "agh $VERSION" && exit 0

PRINT_TOKEN=0
if [[ ${1:-} == "--print-token" ]]; then
    PRINT_TOKEN=1
    shift
fi

[[ -r $AGH_PRIVATE_KEY_PATH ]] || die "cannot read AGH_PRIVATE_KEY_PATH: $AGH_PRIVATE_KEY_PATH"
command -v openssl >/dev/null && command -v curl >/dev/null && command -v jq >/dev/null \
    || die "openssl, curl and jq are required"

# --- JWT (RS256) ------------------------------------------------------------
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header='{"alg":"RS256","typ":"JWT"}'
payload="{\"iat\":$((now - 60)),\"exp\":$((now + 540)),\"iss\":\"$AGH_APP_ID\"}"
b64_header=$(printf '%s' "$header" | b64url)
b64_payload=$(printf '%s' "$payload" | b64url)
signature=$(printf '%s.%s' "$b64_header" "$b64_payload" \
    | openssl dgst -sha256 -sign "$AGH_PRIVATE_KEY_PATH" -binary | b64url)
jwt="${b64_header}.${b64_payload}.${signature}"

gh_api() {  # method path [jq-filter] -> body; concise errors, no secrets
    local method=$1 path=$2 filter=${3:-.} out rc
    out=$(curl -sS -w '\n%{http_code}' -X "$method" \
        -H "Authorization: Bearer $jwt" \
        -H "Accept: application/vnd.github+json" \
        "$API$path") || die "curl failed talking to $API"
    local body=${out%$'\n'*} code=${out##*$'\n'}
    if [[ $code != 2* ]]; then
        local msg
        msg=$(jq -r '.message // empty' <<<"$body" 2>/dev/null || true)
        die "GitHub API $method $path -> HTTP $code ${msg:+($msg)}"
    fi
    jq -r "$filter" <<<"$body"
}

# --- installation selection ---------------------------------------------------
# Target repo owner: gh's -R/--repo (space- or =-joined), GH_REPO, else the
# cwd's origin remote. Only GitHub remotes count; anything else yields "".
# Like gh itself, the LAST -R wins when several are passed.
repo_owner() {
    local i=$# v
    while ((i > 0)); do
        v=${!i}
        if [[ $v == -R || $v == --repo ]] && ((i < $#)); then
            local n=$((i + 1)); v=${!n}
        elif [[ $v == -R=* || $v == --repo=* ]]; then
            v=${v#*=}
        else
            i=$((i - 1)); continue
        fi
        [[ $v == */* ]] && { printf '%s' "${v%%/*}"; return; }
        i=$((i - 1))
    done
    [[ ${GH_REPO:-} == */* ]] && { printf '%s' "${GH_REPO%%/*}"; return; }
    local url
    url=$(git remote get-url origin 2>/dev/null) || return 0
    [[ $url == *github.com* ]] || return 0
    printf '%s' "$url" \
        | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#^git@[^:]*:##; s#^github\.com[:/]##; s#\.git$##; s#/.*##'
}

inst=${AGH_INSTALLATION_ID:-auto}
if [[ $inst != auto && ! $inst =~ ^[0-9]+$ ]]; then
    die "AGH_INSTALLATION_ID must be a number or \"auto\" (got: $inst)"
fi
if [[ $inst == auto ]]; then
    owner=$(repo_owner "$@")
    # GET /app/installations caps at 100 per page and gh_api drops the Link
    # header; accumulate pages until a short page so owners beyond the first
    # 100 hit. A 50-page cap bounds the loop; hitting it is fatal below, not
    # silent truncation.
    installations='[]'
    truncated=0
    page=1
    while :; do
        body=$(gh_api GET "/app/installations?per_page=100&page=$page" '.')
        installations=$(jq -s '.[0] + .[1]' <<<"$installations"$'\n'"$body")
        (( $(jq 'length' <<<"$body") < 100 )) && break
        page=$((page + 1))
        if ((page > 50)); then truncated=1; break; fi
    done
    [[ $installations != '[]' ]] \
        || die "no installation found for app $AGH_APP_ID (install the app on at least one org/repo)"
    if [[ -n $owner ]]; then
        # One installation per account per app; suspended installs are skipped.
        inst=$(jq -r --arg o "$owner" '
            .[] | select(.suspended_at == null)
                | select(((.account.login // "") | ascii_downcase) == ($o | ascii_downcase))
                | .id' <<<"$installations" | head -n1)
        if [[ -z $inst ]]; then
            logins=$(jq -r '.[].account.login // "?"' <<<"$installations" | paste -sd, -)
            die "app $AGH_APP_ID is not installed on \"$owner\" (installed on: $logins)${truncated:+ — list truncated at 5000 installations, pin AGH_INSTALLATION_ID if the target is beyond it}"
        fi
    else
        # No repo context and multiple installs: refuse rather than mint a
        # token for an arbitrary account.
        if (( $(jq 'length' <<<"$installations") == 1 )); then
            inst=$(jq -r '.[0].id' <<<"$installations")
        else
            logins=$(jq -r '.[].account.login // "?"' <<<"$installations" | paste -sd, -)
            die "no repo context to select an installation for app $AGH_APP_ID (installed on: $logins); pass -R owner/repo or set AGH_INSTALLATION_ID"
        fi
    fi
fi
token=$(gh_api POST "/app/installations/$inst/access_tokens" '.token // empty')
[[ -n $token ]] || die "could not obtain installation token"

if [[ $PRINT_TOKEN == 1 ]]; then
    # Explicit opt-in only. Token expires in ~1h and is never printed otherwise.
    printf '%s\n' "$token"
    exit 0
fi

# Invoke real gh explicitly: `ggh` (user alias for `command gh`) when present,
# else a literal `gh` — never the recursive `gh`->`agh` alias.
gh_bin=gh
command -v ggh >/dev/null 2>&1 && gh_bin=ggh
exec env GH_TOKEN="$token" "$gh_bin" "$@"
