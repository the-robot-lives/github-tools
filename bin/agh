#!/usr/bin/env bash
# agh — run `gh` authenticated as a GitHub App installation instead of the user.
#
# Usage:  agh [gh args...]            e.g. agh pr view 42 -R owner/repo
#         agh --print-token           print the short-lived installation token (explicit opt-in)
#         agh --help
#
# Credentials (env / direnv — never committed). Defaults shown are for the
# noizu-agentic-coder app (app 5220485, the-robot-lives org installation).
#   AGH_APP_ID           GitHub App numeric id (default 5220485)
#   AGH_INSTALLATION_ID  installation id (default 168768636 = the-robot-lives
#                        org; 168768280 = personal @noizu). "auto" or unset
#                        default resolves via GET /app/installations; use "auto"
#                        explicitly to require exactly one installation.
#   AGH_PRIVATE_KEY_PATH app's PEM private key (default
#                        ~/Work/Space/Noizu/secrets/noizu-agentic-coder.private-key.pem)
#
# Dependencies: openssl, curl, jq. Exits with gh's status otherwise;
# non-gh failures exit 3 (matches gh-wait's usage/tool-error code).

set -euo pipefail

API="https://api.github.com"
VERSION="0.2.0"

# Defaults for the noizu-agentic-coder GitHub App (override via env).
: "${AGH_APP_ID:=5220485}"
: "${AGH_INSTALLATION_ID:=168768636}"
: "${AGH_PRIVATE_KEY_PATH:=$HOME/Work/Space/Noizu/secrets/noizu-agentic-coder.private-key.pem}"

die() { echo "agh: $*" >&2; exit 3; }

[[ ${1:-} == "--help" || ${1:-} == "-h" ]] && sed -n '2,15p' "$0" && exit 0
[[ ${1:-} == "--version" ]] && echo "agh $VERSION" && exit 0

PRINT_TOKEN=0
if [[ ${1:-} == "--print-token" ]]; then
    PRINT_TOKEN=1
    shift
fi

[[ -r $AGH_PRIVATE_KEY_PATH ]] || die "cannot read AGH_PRIVATE_KEY_PATH: $AGH_PRIVATE_KEY_PATH"
command -v openssl >/dev/null && command -v curl >/dev/null && command -v jq >/dev/null \
    || die "openssl, curl and jq are required"

# --- JWT (RS256) ------------------------------------------------------------
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header='{"alg":"RS256","typ":"JWT"}'
payload="{\"iat\":$((now - 60)),\"exp\":$((now + 540)),\"iss\":\"$AGH_APP_ID\"}"
b64_header=$(printf '%s' "$header" | b64url)
b64_payload=$(printf '%s' "$payload" | b64url)
signature=$(printf '%s.%s' "$b64_header" "$b64_payload" \
    | openssl dgst -sha256 -sign "$AGH_PRIVATE_KEY_PATH" -binary | b64url)
jwt="${b64_header}.${b64_payload}.${signature}"

gh_api() {  # method path [jq-filter] -> body; concise errors, no secrets
    local method=$1 path=$2 filter=${3:-.} out rc
    out=$(curl -sS -w '\n%{http_code}' -X "$method" \
        -H "Authorization: Bearer $jwt" \
        -H "Accept: application/vnd.github+json" \
        "$API$path") || die "curl failed talking to $API"
    local body=${out%$'\n'*} code=${out##*$'\n'}
    if [[ $code != 2* ]]; then
        local msg
        msg=$(jq -r '.message // empty' <<<"$body" 2>/dev/null || true)
        die "GitHub API $method $path -> HTTP $code ${msg:+($msg)}"
    fi
    jq -r "$filter" <<<"$body"
}

# --- installation token -----------------------------------------------------
inst=${AGH_INSTALLATION_ID:-auto}
if [[ $inst == auto ]]; then
    inst=$(gh_api GET /app/installations '.[0].id // empty')
    [[ -n $inst ]] || die "no installation found for app $AGH_APP_ID (install the app on at least one org/repo)"
fi
token=$(gh_api POST "/app/installations/$inst/access_tokens" '.token // empty')
[[ -n $token ]] || die "could not obtain installation token"

if [[ $PRINT_TOKEN == 1 ]]; then
    # Explicit opt-in only. Token expires in ~1h and is never printed otherwise.
    printf '%s\n' "$token"
    exit 0
fi

# Invoke real gh explicitly: `ggh` (user alias for `command gh`) when present,
# else a literal `gh` — never the recursive `gh`->`agh` alias.
gh_bin=gh
command -v ggh >/dev/null 2>&1 && gh_bin=ggh
exec env GH_TOKEN="$token" "$gh_bin" "$@"
